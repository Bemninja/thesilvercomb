<style is:global>
  header,
  footer {
    display: none !important;
  }
  html,
  body {
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
    height: 100vh !important;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("silver-comb-container");

    if (container) {
      container.focus();

      // 1. TASTATUR NAVIGATION
      window.addEventListener("keydown", (e) => {
        const isNext = e.key === "ArrowDown" || e.key === "PageDown" || (e.key === " " && !e.shiftKey);
        const isPrev = e.key === "ArrowUp" || e.key === "PageUp" || (e.key === " " && e.shiftKey);

        if (isNext) {
          e.preventDefault();
          container.scrollBy({ top: container.clientHeight, behavior: "smooth" });
        } else if (isPrev) {
          e.preventDefault();
          container.scrollBy({ top: -container.clientHeight, behavior: "smooth" });
        }
      });

      // 2. ZOOM OG UNLIMITED DRAG LOGIK
      const images = document.querySelectorAll(".zoomable-img");

      images.forEach((img) => {
        const wrapper = img.parentElement;
        let zoomLevel = 0; // 0, 1, 2
        let isDragging = false;
        let startX = 0,
          startY = 0;
        let currentX = 0,
          currentY = 0;

        const updateTransform = (smooth) => {
          img.style.transition = smooth ? "transform 0.25s ease-out" : "none";
          wrapper.style.transition = smooth ? "transform 0.25s ease-out" : "none";

          if (zoomLevel === 0) {
            currentX = 0;
            currentY = 0;
            img.style.transform = "scale(1)";
            wrapper.style.transform = "translate(0px, 0px)";
            container.style.overflowY = "scroll";
          } else {
            const scale = zoomLevel === 1 ? 1.8 : 2.8;
            img.style.transform = `scale(${scale})`;
            wrapper.style.transform = `translate(${currentX}px, ${currentY}px)`;
            container.style.overflowY = "hidden";
          }
        };

        // DOBBELTKLIK / DOBBELTTAP
        img.addEventListener("dblclick", (e) => {
          e.preventDefault();

          if (zoomLevel === 0) {
            zoomLevel = 1;
            const rect = img.getBoundingClientRect();
            const offsetX = e.clientX - (rect.left + rect.width / 2);
            const offsetY = e.clientY - (rect.top + rect.height / 2);

            currentX = -offsetX;
            currentY = -offsetY;

            img.classList.remove("cursor-zoom-in");
            img.classList.add("cursor-grab");
          } else if (zoomLevel === 1) {
            zoomLevel = 2;
            img.classList.remove("cursor-grab");
            img.classList.add("cursor-zoom-out");
          } else {
            zoomLevel = 0;
            img.classList.remove("cursor-zoom-out", "cursor-grab");
            img.classList.add("cursor-zoom-in");
          }

          updateTransform(true);
        });

        // STABIL DRAG (PÅ WRAPPEREN)
        img.addEventListener("mousedown", (e) => {
          if (zoomLevel === 0) return;
          e.preventDefault();
          isDragging = true;

          startX = e.clientX - currentX;
          startY = e.clientY - currentY;

          img.classList.remove("cursor-grab", "cursor-zoom-out");
          img.classList.add("cursor-grabbing");
        });

        window.addEventListener("mousemove", (e) => {
          if (!isDragging || zoomLevel === 0) return;
          e.preventDefault();

          currentX = e.clientX - startX;
          currentY = e.clientY - startY;

          updateTransform(false);
        });

        window.addEventListener("mouseup", () => {
          if (isDragging) {
            isDragging = false;
            img.classList.remove("cursor-grabbing");
            img.classList.add(zoomLevel === 2 ? "cursor-zoom-out" : "cursor-grab");
          }
        });

        // NULSTIL VED SCROLL
        container.addEventListener("scroll", () => {
          if (zoomLevel !== 0) {
            zoomLevel = 0;
            updateTransform(true);
          }
        });
      });
    }
  });
</script>

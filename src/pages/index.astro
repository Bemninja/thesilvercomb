---
import MainLayout from "../layouts/MainLayout.astro";
import Link from "../components/Link.astro";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import "../styles/tobii.min.css";
---

<MainLayout title="The Silver Comb">
  <section class="md:block w-screen h-screen overflow-y-scroll snap-y snap-mandatory
         scroll-smooth overscroll-contain
         scroll-behavior-smooth
         scroll-padding-top-12
         px-20 bg-black">
    <div class="snap-start min-h-screen flex justify-center items-center py-1">
      <img src="../assets/images/1.jpg" alt="tsc 1" class="w-full h-full" />
    </div>

    </div>
  </section>
</MainLayout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("silver-comb-container");

    if (container) {
      // Sæt fokus så tastatur fanger det straks
      container.focus();

      window.addEventListener("keydown", (e) => {
        // Tjekker om man trykker ned, PageDown eller Mellemrum (uden Shift)
        const isNext = e.key === "ArrowDown" || e.key === "PageDown" || (e.key === " " && !e.shiftKey);

        // Tjekker om man trykker op, PageUp eller Shift + Mellemrum
        const isPrev = e.key === "ArrowUp" || e.key === "PageUp" || (e.key === " " && e.shiftKey);

        if (isNext) {
          e.preventDefault();
          container.scrollBy({ top: container.clientHeight, behavior: "smooth" });
        } else if (isPrev) {
          e.preventDefault();
          container.scrollBy({ top: -container.clientHeight, behavior: "smooth" });
        }
      });
    }
  });
</script>

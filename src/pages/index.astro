<script>
  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("silver-comb-container");

    if (container) {
      container.focus();

      // 1. TASTATUR NAVIGATION
      window.addEventListener("keydown", (e) => {
        const isNext = e.key === "ArrowDown" || e.key === "PageDown" || (e.key === " " && !e.shiftKey);
        const isPrev = e.key === "ArrowUp" || e.key === "PageUp" || (e.key === " " && e.shiftKey);

        if (isNext) {
          e.preventDefault();
          container.scrollBy({ top: container.clientHeight, behavior: "smooth" });
        } else if (isPrev) {
          e.preventDefault();
          container.scrollBy({ top: -container.clientHeight, behavior: "smooth" });
        }
      });

      // 2. UNIVERSEL ZOOM, TOUCH PAN OG DOBBELTTAP
      const images = document.querySelectorAll(".zoomable-img");

      images.forEach((img) => {
        let currentScale = 1;
        let currentX = 0;
        let currentY = 0;

        let isDragging = false;
        let startX = 0,
          startY = 0;

        let initialPinchDist = 0;
        let initialPinchScale = 1;

        // Custom mobile double-tap timer variables
        let lastTapTime = 0;

        const updateTransform = (smooth = false) => {
          img.style.transition = smooth ? "transform 0.25s ease-out" : "none";

          if (currentScale <= 1.05) {
            currentScale = 1;
            currentX = 0;
            currentY = 0;
            img.style.transform = "";
            img.style.touchAction = "pan-y"; // Tillad normal højdescroll på mobil når ikke zoomet
            container.style.overflowY = "scroll";
            img.classList.remove("cursor-grab", "cursor-grabbing", "cursor-zoom-out");
            img.classList.add("cursor-zoom-in");
          } else {
            img.style.transform = `translate(${currentX}px, ${currentY}px) scale(${currentScale})`;
            img.style.touchAction = "none"; // Bloker default scroll, så én finger panner billedet
            container.style.overflowY = "hidden";
            img.classList.remove("cursor-zoom-in");
            img.classList.add(isDragging ? "cursor-grabbing" : "cursor-grab");
          }
        };

        const toggleZoom = (clientX, clientY) => {
          if (currentScale === 1) {
            currentScale = 1.8;
            currentX = window.innerWidth / 2 - clientX;
            currentY = window.innerHeight / 2 - clientY;
          } else if (currentScale < 2.5) {
            currentScale = 2.8;
          } else {
            currentScale = 1;
          }
          updateTransform(true);
        };

        // DOBBELTKLIK (DESKTOP)
        img.addEventListener("dblclick", (e) => {
          e.preventDefault();
          toggleZoom(e.clientX, e.clientY);
        });

        // DESKTOP MOUSE DRAG
        img.addEventListener("mousedown", (e) => {
          if (currentScale <= 1) return;
          e.preventDefault();
          isDragging = true;
          startX = e.clientX - currentX;
          startY = e.clientY - currentY;
          updateTransform(false);
        });

        window.addEventListener("mousemove", (e) => {
          if (!isDragging || currentScale <= 1) return;
          e.preventDefault();
          currentX = e.clientX - startX;
          currentY = e.clientY - startY;
          updateTransform(false);
        });

        window.addEventListener("mouseup", () => {
          if (isDragging) {
            isDragging = false;
            updateTransform(false);
          }
        });

        // MOBIL TOUCH (DOUBLE-TAP, 1-FINGER PAN & PINCH-TO-ZOOM)
        img.addEventListener(
          "touchstart",
          (e) => {
            const now = Date.now();

            // 1. Dobbelt-tap på mobil
            if (e.touches.length === 1) {
              if (now - lastTapTime < 300) {
                e.preventDefault();
                toggleZoom(e.touches[0].clientX, e.touches[0].clientY);
                lastTapTime = 0;
                return;
              }
              lastTapTime = now;

              // Start 1-finger drag hvis zoomet ind
              if (currentScale > 1) {
                isDragging = true;
                startX = e.touches[0].clientX - currentX;
                startY = e.touches[0].clientY - currentY;
              }
            }

            // 2. Pinch zoom start (2 fingre)
            if (e.touches.length === 2) {
              isDragging = false;
              initialPinchDist = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
              initialPinchScale = currentScale;
            }
          },
          { passive: false },
        );

        img.addEventListener(
          "touchmove",
          (e) => {
            // 1-finger pan når zoomet
            if (e.touches.length === 1 && isDragging && currentScale > 1) {
              e.preventDefault();
              currentX = e.touches[0].clientX - startX;
              currentY = e.touches[0].clientY - startY;
              updateTransform(false);
            }

            // 2-finger pinch zoom
            if (e.touches.length === 2 && initialPinchDist > 0) {
              e.preventDefault();
              const currentDist = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
              const scaleFactor = currentDist / initialPinchDist;
              currentScale = Math.min(Math.max(initialPinchScale * scaleFactor, 1), 4);
              updateTransform(false);
            }
          },
          { passive: false },
        );

        img.addEventListener("touchend", (e) => {
          if (e.touches.length === 0) {
            isDragging = false;
            initialPinchDist = 0;

            if (currentScale < 1.1) {
              currentScale = 1;
              updateTransform(true);
            }
          }
        });

        // NULSTIL VED SLIDE SCROLL
        container.addEventListener("scroll", () => {
          if (currentScale !== 1) {
            currentScale = 1;
            updateTransform(true);
          }
        });
      });
    }
  });
</script>

---
import MainLayout from "../layouts/MainLayout.astro";
import Link from "../components/Link.astro";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import "../styles/tobii.min.css";
---

<MainLayout title="The Silver Comb - Pitch Deck">
  <!-- Rotate Device Prompt -->
  <div
    id="rotate-prompt"
    class="fixed bottom-6 left-6 z-50 items-center gap-2.5 px-4 py-2.5 rounded-full bg-neutral-900/50 backdrop-blur-md border border-neutral-700/40 text-neutral-300 text-[11px] uppercase tracking-widest font-semibold shadow-2xl pointer-events-none select-none transition-all duration-[1500ms]"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-400 animate-rotate-phone">
      <rect width="12" height="18" x="6" y="3" rx="2"></rect>
      <path d="M12 18h.01"></path>
    </svg>
    <span>Rotate</span>
  </div>

  <!-- Dynamic Contact/Top button -->
  <div class="fixed bottom-6 right-6 z-50">
    <a
      id="contact-top-btn"
      href="#slide-14"
      class="group no-underline inline-flex items-center gap-2.5 px-5 py-2.5 rounded-full bg-neutral-900/50 hover:bg-neutral-900/70 text-neutral-300 hover:text-white backdrop-blur-md border border-neutral-700/40 hover:border-neutral-500/60 text-xs uppercase tracking-widest font-semibold transition-all duration-300 shadow-2xl hover:shadow-neutral-700/20 active:scale-95"
    >
      <span id="btn-text">Contact</span>
      <svg
        id="btn-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-neutral-400 group-hover:text-white transition-transform duration-300 group-hover:translate-x-0.5"
      >
        <rect width="20" height="16" x="2" y="4" rx="2"></rect>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
      </svg>
    </a>
  </div>
</MainLayout>

<section id="pitch-deck-container" tabindex="0" class="w-screen h-[100dvh] overflow-y-scroll snap-y snap-mandatory
         scroll-smooth overscroll-contain
         px-4 md:px-20 bg-black outline-none block">
  <!-- Slide 1 -->
  <div id="slide-1" class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
    <img src="/images/1.jpg" alt="1" draggable="false" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
  </div>

  <!-- Slide 2 -->
  <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
    <img src="/images/2.jpg" alt="2" draggable="false" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
  </div>

  <!-- Slide 3 -->
  <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
    <img src="/images/3.jpg" alt="3" draggable="false" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
  </div>

  <!-- Slide 4 -->
  <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
    <img src="/images/4.jpg" alt="4" draggable="false" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
  </div>

  <!-- Slide 5 -->
  <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
    <img src="/images/5.jpg" alt="5" draggable="false" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
  </div>

  <!-- Slide 6 -->
  <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
    <img src="/images/6.jpg" alt="6" draggable="false" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
  </div>

  <!-- Slide 7 -->
  <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
    <img src="/images/7.jpg" alt="7" draggable="false" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
  </div>

  <!-- Slide 8 -->
  <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
    <img src="/images/8.jpg" alt="8" draggable="false" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
  </div>

  <!-- Slide 9 -->
  <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
    <img src="/images/9.jpg" alt="9" draggable="false" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
  </div>

  <!-- Slide 10 -->
  <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
    <img src="/images/10.jpg" alt="10" draggable="false" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
  </div>

  <!-- Slide 11 -->
  <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
    <img src="/images/11.jpg" alt="11" draggable="false" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
  </div>

  <!-- Slide 12 -->
  <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
    <img src="/images/12.jpg" alt="12" draggable="false" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
  </div>

  <!-- Slide 13 -->
  <div class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
    <img src="/images/13.jpg" alt="13" draggable="false" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
  </div>

  <!-- Slide 14 -->
  <div id="slide-14" class="snap-center snap-always h-[100dvh] w-full flex-shrink-0 flex justify-center items-center my-auto">
    <img src="/images/14.jpg" alt="14" draggable="false" class="zoomable-img max-h-[85vh] max-h-[85dvh] max-w-[90vw] object-contain cursor-zoom-in select-none" />
  </div>
</section>

<style is:global>
  header,
  footer {
    display: none !important;
  }
  html,
  body {
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
    height: 100vh !important;
    height: 100dvh !important;
  }

  /* Rotation animation for telefonen */
  @keyframes rotateDevice {
    0%,
    10% {
      transform: rotate(0deg);
    }
    40%,
    60% {
      transform: rotate(-90deg);
    }
    90%,
    100% {
      transform: rotate(0deg);
    }
  }

  .animate-rotate-phone {
    animation: rotateDevice 3s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  /* Prompt Visibility Management */
  #rotate-prompt {
    display: none;
    opacity: 1;
    visibility: visible;
  }

  @media (max-width: 767px) and (orientation: portrait) {
    #rotate-prompt {
      display: flex;
    }
  }

  #rotate-prompt.fade-out {
    opacity: 0;
    visibility: hidden;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Smoothly fade out and hide the prompt after 15 seconds
    const rotatePrompt = document.getElementById("rotate-prompt");
    if (rotatePrompt) {
      setTimeout(() => {
        rotatePrompt.classList.add("fade-out");
      }, 15000);
    }

    const container = document.getElementById("pitch-deck-container");
    const slide14 = document.getElementById("slide-14");
    const btn = document.getElementById("contact-top-btn");
    const btnText = document.getElementById("btn-text");
    const btnIcon = document.getElementById("btn-icon");

    if (slide14 && btn && btnText && btnIcon && container) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              btn.setAttribute("href", "#slide-1");
              btnText.textContent = "Top";
              btnIcon.innerHTML = `<path d="m18 15-6-6-6 6"/>`;
            } else {
              btn.setAttribute("href", "#slide-14");
              btnText.textContent = "Contact";
              btnIcon.innerHTML = `<rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>`;
            }
          });
        },
        { root: container, threshold: 0.6 },
      );
      observer.observe(slide14);
    }

    if (container) {
      container.focus();

      window.addEventListener("keydown", (e) => {
        const isNext = e.key === "ArrowDown" || e.key === "PageDown" || (e.key === " " && !e.shiftKey);
        const isPrev = e.key === "ArrowUp" || e.key === "PageUp" || (e.key === " " && e.shiftKey);

        if (isNext) {
          e.preventDefault();
          container.scrollBy({ top: container.clientHeight, behavior: "smooth" });
        } else if (isPrev) {
          e.preventDefault();
          container.scrollBy({ top: -container.clientHeight, behavior: "smooth" });
        }
      });

      const images = document.querySelectorAll(".zoomable-img");

      images.forEach((img) => {
        img.ondragstart = () => false;

        let currentScale = 1;
        let currentX = 0;
        let currentY = 0;

        let isDragging = false;
        let startX = 0,
          startY = 0;

        let initialPinchDist = 0;
        let initialPinchScale = 1;

        const updateTransform = (smooth = false) => {
          img.style.transition = smooth ? "transform 0.25s ease-out" : "none";

          if (currentScale <= 1.05) {
            currentScale = 1;
            currentX = 0;
            currentY = 0;
            img.style.transform = "";
            img.style.touchAction = "pan-y";
            if (container) container.style.overflowY = "scroll";
            img.classList.remove("cursor-grab", "cursor-grabbing", "cursor-zoom-out");
            img.classList.add("cursor-zoom-in");
          } else {
            img.style.transform = `translate(${currentX}px, ${currentY}px) scale(${currentScale})`;
            img.style.touchAction = "none";
            if (container) container.style.overflowY = "hidden";
            img.classList.remove("cursor-zoom-in");
            img.classList.add(isDragging ? "cursor-grabbing" : "cursor-grab");
          }
        };

        img.addEventListener("dblclick", (e) => {
          e.preventDefault();

          let targetScale = 1;

          if (currentScale === 1) {
            targetScale = 1.8;
          } else if (currentScale < 2.5) {
            targetScale = 2.8;
          } else {
            targetScale = 1;
          }

          if (targetScale === 1) {
            currentScale = 1;
            currentX = 0;
            currentY = 0;
          } else {
            const rect = img.getBoundingClientRect();
            const unscaledCenterX = rect.left + rect.width / 2 - currentX;
            const unscaledCenterY = rect.top + rect.height / 2 - currentY;

            const clickX = e.clientX - unscaledCenterX;
            const clickY = e.clientY - unscaledCenterY;

            const targetX = clickX - (clickX - currentX) * (targetScale / currentScale);
            const targetY = clickY - (clickY - currentY) * (targetScale / currentScale);

            currentX = targetX;
            currentY = targetY;
            currentScale = targetScale;
          }

          updateTransform(true);
        });

        img.addEventListener("pointerdown", (e) => {
          if (currentScale <= 1) return;
          e.preventDefault();

          isDragging = true;
          startX = e.clientX - currentX;
          startY = e.clientY - currentY;

          if (img.setPointerCapture) {
            try {
              img.setPointerCapture(e.pointerId);
            } catch (_) {}
          }

          updateTransform(false);
        });

        img.addEventListener("pointermove", (e) => {
          if (!isDragging || currentScale <= 1) return;
          e.preventDefault();

          currentX = e.clientX - startX;
          currentY = e.clientY - startY;

          updateTransform(false);
        });

        const stopDrag = (e) => {
          if (isDragging) {
            isDragging = false;
            if (img.hasPointerCapture && img.hasPointerCapture(e.pointerId)) {
              try {
                img.releasePointerCapture(e.pointerId);
              } catch (_) {}
            }
            updateTransform(false);
          }
        };

        img.addEventListener("pointerup", stopDrag);
        img.addEventListener("pointercancel", stopDrag);

        img.addEventListener(
          "touchstart",
          (e) => {
            if (e.touches.length === 2) {
              initialPinchDist = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
              initialPinchScale = currentScale;
            }
          },
          { passive: true },
        );

        img.addEventListener(
          "touchmove",
          (e) => {
            if (e.touches.length === 2 && initialPinchDist > 0) {
              e.preventDefault();
              const currentDist = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
              const scaleFactor = currentDist / initialPinchDist;
              currentScale = Math.min(Math.max(initialPinchScale * scaleFactor, 1), 4);
              updateTransform(false);
            }
          },
          { passive: false },
        );

        img.addEventListener("touchend", (e) => {
          if (e.touches.length < 2) {
            initialPinchDist = 0;
            if (currentScale < 1.05) {
              currentScale = 1;
              updateTransform(true);
            }
          }
        });

        if (container) {
          container.addEventListener("scroll", () => {
            if (currentScale !== 1) {
              currentScale = 1;
              updateTransform(true);
            }
          });
        }
      });
    }
  });
</script>

    </div>

    <!-- Slide 9 -->
    <div class="snap-center snap-always h-screen h-[100dvh] w-full flex-shrink-0 flex justify-center items-center">
      <img src="../images/9.jpg" alt="The silver comb 9" class="max-h-[85vh] max-w-[90vw] object-contain pointer-events-none select-none" />
    </div>

